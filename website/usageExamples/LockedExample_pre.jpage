import lombok.Locked;

@Locked.Policy(fairness = true)
public class LockedExample {
	private int value = 0;
	
	@Locked.Read
	public int getValue() {
		return value;
	}
	
	@Locked.Write
	public void setValue(int newValue) {
		value = newValue;
	}
	
	@Locked("baseLock")
	public void foo() {
		System.out.println("bar");
	}
}
